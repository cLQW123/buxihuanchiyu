new file mode 100644
index 00000000..2541cbd3
--- /dev/null
+++ b/src/infiniop/ops/vae_support/ninetoothed/initializers.py
@@ -0,0 +1,76 @@
+"""NineToothed numerical buffers created while loading the H3 VAEs."""
+import ninetoothed as nt
+import ninetoothed.language as ntl
+from ninetoothed.language import libdevice
+
+
+def rotary_arrangement(output, count, theta):
+    return output.tile((128,)), count, theta
+
+
+def rotary_application(output, count, theta):
+    index = ntl.cast(output.offsets(-1), ntl.float64)
+    step = ntl.full((), 1.0 / count, dtype=ntl.float64)
+    exponent = ntl.cast(index * step, ntl.float32)
+    base = ntl.full((), theta, dtype=ntl.float32)
+    powered = libdevice.pow(base, exponent)
+    output = 1.0 / powered
+
+
+def premake_rotary(count, theta):
+    return rotary_arrangement, rotary_application, (
+        nt.Tensor(1, dtype=nt.float32),
+        nt.Tensor(0, constexpr=True, value=count),
+        nt.Tensor(0, constexpr=True, value=theta))
+
+
+def filter_arrangement(output, count, cutoff, beta):
+    return output.tile((128,)), count, cutoff, beta
+
+
+def filter_application(output, count, cutoff, beta):
+    index = ntl.cast(output.offsets(-1), ntl.float32)
+    alpha = (count - 1) / 2.0
+    normalized = (index - alpha) / alpha
+    beta32 = ntl.full((), beta, dtype=ntl.float32)
+    argument = beta32 * ntl.sqrt(ntl.maximum(1.0 - normalized * normalized, 0.0))
+    numerator = ntl.full((128,), 1.0, dtype=ntl.float32)
+    denominator = ntl.full((), 1.0, dtype=ntl.float32)
+    term = ntl.full((128,), 1.0, dtype=ntl.float32)
+    base_term = ntl.full((), 1.0, dtype=ntl.float32)
+    for order in range(1, 32):
+        term = term * (argument * argument / 4.0) / (order * order)
+        base_term = base_term * (beta32 * beta32 / 4.0) / (order * order)
+        numerator = numerator + term
+        denominator = denominator + base_term
+    window = numerator / denominator
+    time = index - count // 2
+    if count % 2 == 0:
+        time = time + 0.5
+    frequency = 2.0 * cutoff * time
+    phase = 3.141592653589793 * frequency
+    sinc = ntl.where(frequency == 0, 1.0, libdevice.sin(phase) / phase)
+    output = 2.0 * cutoff * window * sinc
+
+
+def premake_filter(count, cutoff, beta):
+    return filter_arrangement, filter_application, (
+        nt.Tensor(1, dtype=nt.float32),
+        nt.Tensor(0, constexpr=True, value=count),
+        nt.Tensor(0, constexpr=True, value=cutoff),
+        nt.Tensor(0, constexpr=True, value=beta))
+
+
+def normalize_arrangement(input, output):
+    source = input.tile((128,))
+    return source, output.tile((128,))
+
+
+def normalize_application(input, output):
+    total = ntl.sum(input, 0)
+    output = input / total
+
+
+def premake_normalize():
+    return normalize_arrangement, normalize_application, (
+        nt.Tensor(1, dtype=nt.float32, other=0), nt.Tensor(1, dtype=nt.float32))
diff --git a/src/infiniop/ops/vae_support/ninetoothed/normalization.py b/src/infiniop/ops/vae_support/ninetoothed/normalization.py
new file mode 100644
index 00000000..9ccf4c79
--- /dev/null
+++ b/src/infiniop/ops/vae_support/ninetoothed/normalization.py
@@ -0,0 +1,43 @@
+"""NineToothed RMSNorm/LayerNorm with independently typed affine storage."""
+import functools
+
+import ninetoothed as nt
+import ninetoothed.language as ntl
+
+
+def arrangement(input, weight, bias, output, eps, centered, *, width):
+    def rows(tensor):
+        tiled = tensor.tile((1, width))
+        tiled.dtype = tiled.dtype.squeeze(0)
+        return tiled
+    w = weight[None, :].expand((input.shape[0], -1))
+    b = bias[None, :].expand((input.shape[0], -1))
+    return rows(input), rows(w), rows(b), rows(output), eps, centered
+
+
+def application(input, weight, bias, output, eps, centered):
+    values = ntl.cast(input, ntl.float32)
+    count = input.source.shape[-1]
+    if centered:
+        mean = ntl.sum(values, 0) / count
+        centered_values = values - mean
+        centered_values = ntl.where(input.offsets(-1) < count, centered_values, 0)
+        variance = ntl.sum(centered_values * centered_values, 0) / count
+        normalized = centered_values * ntl.rsqrt(variance + ntl.cast(eps, ntl.float32))
+    else:
+        variance = ntl.sum(values * values, 0) / count
+        normalized = values * ntl.rsqrt(variance + ntl.cast(eps, ntl.float32))
+    output = normalized * ntl.cast(weight, ntl.float32) + ntl.cast(bias, ntl.float32)
+
+
+def premake(width, centered, input_dtype, weight_dtype=None, bias_dtype=None, output_dtype=None):
+    weight_dtype = weight_dtype or input_dtype
+    bias_dtype = bias_dtype or input_dtype
+    output_dtype = output_dtype or input_dtype
+    tensors = (nt.Tensor(shape=(None, width), dtype=input_dtype, other=0),
+               nt.Tensor(shape=(width,), dtype=weight_dtype, other=0),
+               nt.Tensor(shape=(width,), dtype=bias_dtype, other=0),
+               nt.Tensor(shape=(None, width), dtype=output_dtype),
+               nt.Tensor(0, dtype=nt.float64),
+               nt.Tensor(0, constexpr=True, value=int(centered)))
+    return functools.partial(arrangement, width=width), application, tensors
diff --git a/src/infiniop/ops/vae_support/ninetoothed/positions.py b/src/infiniop/ops/vae_support/ninetoothed/positions.py
new file mode 100644
index 00000000..7b283ad8
--- /dev/null
+++ b/src/infiniop/ops/vae_support/ninetoothed/positions.py
@@ -0,0 +1,58 @@
+"""FL2VA packed rotary positions, including sequential FP64 time sums."""
+import ninetoothed as nt
+import ninetoothed.language as ntl
+
+
+def arrangement(output, text, frames, height, width, patch_h, patch_w, audio, channels, anchors):
+    return (output.tile((128, 4)), text, frames, height, width,
+            patch_h, patch_w, audio, channels, anchors)
+
+
+def application(output, text, frames, height, width, patch_h, patch_w, audio, channels, anchors):
+    row = output.offsets(-2)
+    axis = output.offsets(-1)
+    rows_per_frame = (height // patch_h) * (width // patch_w)
+    audio_start = text + anchors * rows_per_frame
+    video_start = audio_start + audio * channels
+    video_row = ntl.maximum(row - video_start, 0)
+    frame = video_row // rows_per_frame
+    clock = ntl.full((128,), 0.0, dtype=ntl.float64)
+    for index in range(frames):
+        span = ntl.full((), 1.6666666666666667, dtype=ntl.float64)
+        if index % 5 != 0:
+            span = span * 4.0
+        clock = clock + ntl.where(index < frame, span, 0.0)
+    text64 = ntl.full((), text, dtype=ntl.float64)
+    time = ntl.where(row < text, ntl.cast(row, ntl.float64),
+                    ntl.where(row < audio_start, text64,
+                              ntl.where(row < video_start,
+                                        text64 + ntl.cast((row - audio_start) % audio, ntl.float64),
+                                        text64 + clock)))
+    spatial_row = ntl.where(row < audio_start, row - text, video_row) % rows_per_frame
+    h_index = ntl.cast(spatial_row // (width // patch_w), ntl.float64)
+    w_index = ntl.cast(spatial_row % (width // patch_w), ntl.float64)
+    area = ntl.full((), height * width, dtype=ntl.float64)
+    root = ntl.sqrt(area)
+    h_ratio = ntl.full((), height, dtype=ntl.float64) / root
+    w_ratio = ntl.full((), width, dtype=ntl.float64) / root
+    h_left = (1.0 - h_ratio) / 2.0
+    w_left = (1.0 - w_ratio) / 2.0
+    h_step = ((h_left + h_ratio) - h_left) / (height // patch_h)
+    w_step = ((w_left + w_ratio) - w_left) / (width // patch_w)
+    h_coord = (h_left + h_index * h_step) * 32.0
+    w_coord = (w_left + w_index * w_step) * 32.0
+    audio_w_index = ntl.where(row - audio_start < audio, 0, width // patch_w - 1)
+    audio_w = (w_left + ntl.cast(audio_w_index, ntl.float64) * w_step) * 32.0
+    is_video = (row >= text) & ((row < audio_start) | (row >= video_start))
+    h_coord = ntl.where(is_video, h_coord, 0.0)
+    w_coord = ntl.where(is_video, w_coord,
+                        ntl.where(row >= audio_start, audio_w, 0.0))
+    output = ntl.where(axis[None, :] == 0, time[:, None],
+                       ntl.where(axis[None, :] == 1, h_coord[:, None], w_coord[:, None]))
+
+
+def premake(text, frames, height, width, patch_h, patch_w, audio, channels, anchors):
+    values = (text, frames, height, width, patch_h, patch_w, audio, channels, anchors)
+    tensors = (nt.Tensor(2, dtype=nt.float64),) + tuple(
+        nt.Tensor(0, constexpr=True, value=value) for value in values)
+    return arrangement, application, tensors
diff --git a/src/infiniop/ops/vae_support/ninetoothed/random.py b/src/infiniop/ops/vae_support/ninetoothed/random.py
