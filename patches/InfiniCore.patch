index 00000000..a5261d54
--- /dev/null
+++ b/src/infiniop/ops/vae_support/ninetoothed/random.py
@@ -0,0 +1,99 @@
+"""MT19937 stream and normal transform expressed through NineToothed.
+
+The host bridge only serializes the released CPU generator state. Integer
+recurrence, tempering, uniform conversion and Box-Muller run on the device.
+"""
+import functools
+
+import ninetoothed as nt
+import ninetoothed.language as ntl
+from ninetoothed.language import libdevice
+
+
+def _serial(tensor):
+    result = tensor.tile((1,)).tile((-1,))
+    result.dtype.dtype = result.dtype.dtype.squeeze(0)
+    return result
+
+
+def stream_arrangement(state, output, initial_index, initial_twist):
+    return _serial(state), _serial(output), initial_index, initial_twist
+
+
+def stream_application(state, output, initial_index, initial_twist):
+    cursor = initial_index
+    for position in range(output.source.shape[0]):
+        if cursor == 624 or (position == 0 and initial_twist):
+            for index in range(624):
+                first = state[index]
+                second = state[(index + 1) % 624]
+                bits = (first & 2147483648) | (second & 2147483647)
+                distant = state[(index + 397) % 624]
+                state[index] = distant ^ (bits >> 1) ^ ntl.where(
+                    (second & 1) != 0, 2567483615, 0)
+            cursor = 0
+        value = state[cursor]
+        value = value ^ (value >> 11)
+        value = value ^ ((value << 7) & 2636928640)
+        value = value ^ ((value << 15) & 4022730752)
+        value = value ^ (value >> 18)
+        output[position] = value
+        cursor += 1
+
+
+def premake_stream(initial_index, initial_twist):
+    return stream_arrangement, stream_application, (
+        nt.Tensor(shape=(624,), dtype=nt.uint32),
+        nt.Tensor(1, dtype=nt.uint32),
+        nt.Tensor(0, constexpr=True, value=initial_index),
+        nt.Tensor(0, constexpr=True, value=initial_twist),
+    )
+
+
+def normal_arrangement(raw, output, count, digits):
+    # A complete raw stream is available to each output tile. Dynamic indexing
+    # selects paired uniforms without creating a third-party RNG dependency.
+    arranged = _serial(raw).expand((output.tile((128,)).shape[0],))
+    return arranged, output.tile((128,)), count, digits
+
+
+def normal_application(raw, output, count, digits):
+    index = output.offsets(-1)
+    group = index // 16 * 16
+    slot = index % 16
+    if count % 16 != 0:
+        final = index >= count - 16
+        group = ntl.where(final, count, group)
+        slot = ntl.where(final, index - (count - 16), slot)
+    paired = slot % 8
+    first = raw[group + paired]
+    second = raw[group + paired + 8]
+    u1 = ntl.cast(first & ((1 << digits) - 1), ntl.float32) * (1.0 / (1 << digits))
+    u2 = ntl.cast(second & ((1 << digits) - 1), ntl.float32) * (1.0 / (1 << digits))
+    if digits == 24:
+        radius = ntl.sqrt(-2.0 * ntl.log(1.0 - u1))
+        theta = 6.2831854820251465 * u2
+        cosine = ntl.cos(theta)
+        sine = ntl.sin(theta)
+        output = radius * ntl.where(slot < 8, cosine, sine)
+    else:
+        # The released CPU low-precision normal_fill stores each scalar
+        # intermediate in scalar_t; retain those rounding boundaries.
+        complement = ntl.cast(1.0 - u1, output.dtype)
+        logarithm = ntl.cast(libdevice.log(ntl.cast(complement, ntl.float32)), output.dtype)
+        radius = ntl.cast(libdevice.sqrt(-2.0 * ntl.cast(logarithm, ntl.float32)), output.dtype)
+        theta_wide = 6.283185307179586 * ntl.cast(u2, ntl.float64)
+        theta = ntl.cast(ntl.cast(theta_wide, ntl.float32), output.dtype)
+        cosine = ntl.cast(libdevice.cos(ntl.cast(theta, ntl.float32)), output.dtype)
+        sine = ntl.cast(libdevice.sin(ntl.cast(theta, ntl.float32)), output.dtype)
+        output = ntl.cast(radius, ntl.float32) * ntl.cast(
+            ntl.where(slot < 8, cosine, sine), ntl.float32)
+
+
+def premake_normal(count, dtype):
+    digits = {nt.float32: 24, nt.float16: 11, nt.bfloat16: 8}[dtype]
+    return normal_arrangement, normal_application, (
+        nt.Tensor(1, dtype=nt.uint32), nt.Tensor(1, dtype=dtype),
+        nt.Tensor(0, constexpr=True, value=count),
+        nt.Tensor(0, constexpr=True, value=digits),
+    )
diff --git a/src/infiniop/ops/vae_support/ninetoothed/support.py b/src/infiniop/ops/vae_support/ninetoothed/support.py
new file mode 100644
index 00000000..d8ac33e1
--- /dev/null
+++ b/src/infiniop/ops/vae_support/ninetoothed/support.py
@@ -0,0 +1,60 @@
+"""NineToothed VAE conversion, padding and weight norm candidates."""
+import functools
+import ninetoothed as nt
+import ninetoothed.language as ntl
+from ninetoothed import Symbol
+from ntops.kernels.element_wise import arrangement as elementwise
+from ntops.kernels.reduction import arrangement as reduction
+def pointwise(input,other,output,operation,lower,upper):
+ x=ntl.cast(input,ntl.float32);y=ntl.cast(other,ntl.float32)
+ if operation==0:output=input
+ elif operation==1:output=x+y
+ elif operation==2:output=x*y
+ elif operation==3:output=x-y
+ elif operation==4:output=x/y
+ elif operation==5:output=y-x
+ elif operation==6:output=ntl.exp(x)
+ elif operation==7:output=ntl.sin(x)
+ elif operation==8:output=ntl.cos(x)
+ elif operation==9:output=-x
+ elif operation==10:output=x*ntl.sigmoid(x)
+ elif operation==11:output=x*x
+ elif operation==12:output=1.0/x
+ elif operation==13:output=ntl.minimum(ntl.maximum(x,lower),upper)
+def premake_pointwise(ndim,operation,input_dtype=None,other_dtype=None,output_dtype=None,lower=-float('inf'),upper=float('inf')):
+ if not 0<=operation<=13:raise ValueError('Unknown VAE pointwise operation')
+ tensors=(nt.Tensor(ndim,dtype=input_dtype),nt.Tensor(ndim,dtype=other_dtype),nt.Tensor(ndim,dtype=output_dtype),nt.Tensor(0,constexpr=True,value=operation),nt.Tensor(0,constexpr=True,value=lower),nt.Tensor(0,constexpr=True,value=upper))
+ return functools.partial(elementwise,block_size=512),pointwise,tensors
+def padding_arrangement(input,output,*,padding,mode):
+ if mode=='constant':padded=input.pad(padding)
+ else:
+  input._inputs.append([])
+  def offsets(indices):
+   mapped=[]
+   for index,size,(before,after) in zip(indices,input.shape,padding):
+    if before==0 and after==0:mapped.append(index);continue
+    index=index-before
+    if mode=='replicate':mapped.append(ntl.call('minimum',ntl.call('maximum',index,0),size-1))
+    else:
+     period=2*(size-1);folded=(index+period)%period;mapped.append(ntl.call('minimum',folded,period-folded))
+   return (tuple(mapped),)
+  padded=nt.Tensor(shape=tuple(size+sum(p) for size,p in zip(input.shape,padding)),dtype=input.dtype,source=input.source,target_dims=input.target_dims,_offsets=offsets,_outputs=[input._inputs[0]])
+  input._levels.append([padded])
+ return elementwise(padded,output,block_size=512)
+def copy_application(input,output):output=input
+def premake_padding(ndim,padding,mode,dtype):
+ if mode not in ('constant','reflect','replicate') or len(padding)!=ndim:raise ValueError('Unsupported padding')
+ return functools.partial(padding_arrangement,padding=padding,mode=mode),copy_application,(nt.Tensor(ndim,dtype=dtype,other=0),nt.Tensor(ndim,dtype=dtype))
+def weight_norm_arrangement(input,gain,output,*,dim,block_size):
+ expanded=gain.expand(tuple(-1 if i==dim else size for i,size in enumerate(input.shape)))
+ return reduction(input,expanded,output,dim=tuple(i for i in range(input.ndim) if i!=dim),block_size=block_size)
+def weight_norm_application(input,gain,output):
+ squares=ntl.zeros(input.dtype.shape,dtype=ntl.float32)
+ for block in range(input.shape[0]):
+  x=ntl.cast(input[block],ntl.float32);squares+=x*x
+ inverse_norm=ntl.rsqrt(ntl.sum(squares,0))
+ for block in range(input.shape[0]):output[block]=ntl.cast(input[block],ntl.float32)*gain[block]*inverse_norm
+def premake_weight_norm(ndim,dim=0,dtype=None):
+ if not 0<=dim<ndim or ndim<2:raise ValueError('Invalid retained dimension')
+ tensors=(nt.Tensor(ndim,dtype=dtype,other=0),nt.Tensor(ndim,dtype=dtype),nt.Tensor(ndim,dtype=dtype))
+ return functools.partial(weight_norm_arrangement,dim=dim,block_size=512),weight_norm_application,tensors
