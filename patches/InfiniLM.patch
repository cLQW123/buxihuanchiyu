+"""Packed FL2VA layout; numeric rotary coordinates are generated by NineToothed."""
+import torch
+
+from infiniop.ops.vae_support.ninetoothed.positions import premake
+from .ninetoothed_vae_encoder import _kernel
+
+
+def build_packed_sequence(text_token_tags, num_latent_frames, latent_height, latent_width,
+                          num_audio_latents, patch_size, audio_channels, audio_tag, video_tag,
+                          keyframe_anchors=()):
+    if any(anchor != 'first' for anchor in keyframe_anchors):
+        raise NotImplementedError('This competition adapter supports FL2VA first-frame anchors')
+    _, patch_h, patch_w = patch_size
+    rows_per_frame = (latent_height // patch_h) * (latent_width // patch_w)
+    text = text_token_tags.numel()
+    condition_rows = len(keyframe_anchors) * rows_per_frame
+    audio_start = text + condition_rows
+    video_start = audio_start + num_audio_latents * audio_channels
+    length = video_start + num_latent_frames * rows_per_frame
+    positions = torch.empty((length, 3), device='cuda', dtype=torch.float64)
+    config = (text, num_latent_frames, latent_height, latent_width, patch_h, patch_w,
+              num_audio_latents, audio_channels, len(keyframe_anchors))
+    _kernel(premake, *config)(positions, *config)
+    # Integer row addressing and modality labels are host-side layout metadata.
+    video_indices = torch.cat((torch.arange(text, audio_start), torch.arange(video_start, length)))
+    audio_indices = torch.arange(audio_start, video_start)
+    text_indices = torch.arange(text)
+    token_tags = torch.empty(length, dtype=torch.long)
+    token_tags[text_indices] = text_token_tags.to(device='cpu', dtype=torch.long)
+    token_tags[audio_indices] = audio_tag
+    token_tags[video_indices] = video_tag
+    return (positions.cpu(), token_tags, video_indices, audio_indices, text_indices, condition_rows, 0)
